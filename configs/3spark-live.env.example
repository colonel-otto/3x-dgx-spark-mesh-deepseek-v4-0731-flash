# The live 3-node TP=3 cluster, as used by scripts/fabric_gate.sh.
# Copy to configs/3spark-live.env and edit. Do not commit the copy.
RUN_LABEL=3spark-tp3-live
TOPOLOGY=ring

# SSH addresses (management LAN). Host aliases from ~/.ssh/config work here too.
NODE_IPS="sparkmain spark1 spark2"
SSH_USER=youruser
# DGX Sparks are provisioned with a distinct account per box.
SSH_USER_MAP="sparkmain=sparkmain spark1=spark1 spark2=spark2"
MGMT_IFNAME=enP7s7

# ---- THE IMPORTANT PART ----------------------------------------------------
# The address each node advertises to its PEERS over the RDMA fabric. These are
# NOT the management IPs. Checking the management LAN would have passed cleanly
# straight through the 2026-08-25 degradation, and a node silently falling back
# to routing over WiFi is a failure we have actually hit.
#
# Note sparkmain's fabric address lives on its LOOPBACK -- persisted with
# `nmcli con mod lo +ipv4.addresses '192.168.200.1/32'`.
FABRIC_ADDRS="sparkmain=192.168.200.1 spark1=192.168.100.2 spark2=192.168.101.2"

# ---- gate thresholds -------------------------------------------------------
# Healthy GB10 pair measures ~4.6 GB/s busbw @64MiB; a degraded node reads ~0.7.
# 3.5 sits well clear of both, so it fails loudly without flapping.
FABRIC_GATE_BUSBW_MIN=3.5
# Healthy 3-rank measures ~3.25 GB/s (measured 2026-08-25 on the fixed fabric;
# the old 0.49 figure was taken on the degraded one and is 6.6x pessimistic).
FABRIC_GATE_BUSBW_MIN_ALL=2.5
FABRIC_GATE_RTT_MAX_MS=2.0

VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1
NCCL_IB_HCA_DEFAULT=rocep1s0f0,rocep1s0f1
API_BASE=http://192.168.10.1:8100
MODEL=deepseek-v4-flash-0731
TP_SIZE=3
PP_SIZE=1
NNODES=3
