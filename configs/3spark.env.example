# Copy to configs/3spark.env and edit. Do not commit secrets.
RUN_LABEL=3spark-pp3
TOPOLOGY=ring
NODE_IPS="192.168.10.1 192.168.10.2 192.168.10.3"
SSH_USER=youruser
MGMT_IFNAME=enP7s7
API_BASE=http://192.168.10.1:8000
MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
TP_SIZE=1
PP_SIZE=3
PP_LAYER_PARTITION=14,15,14
DISTRIBUTED_BACKEND=mp
NNODES=3
MASTER_ADDR=192.168.10.1
MASTER_PORT=29501
SPECULATIVE=false
MODEL_REVISION=
VLLM_IMAGE=
NVIDIA_PLAYBOOK_REF=1fb66f059ee427c5a3678b3117ef73aab042b458
# Optional per-node login override when the nodes do not share a username.
# Format: "ip=user ip=user". Unlisted nodes fall back to SSH_USER.
# DGX Sparks are typically provisioned with a distinct account per box.
SSH_USER_MAP=""
