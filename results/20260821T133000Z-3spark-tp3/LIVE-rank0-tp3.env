# Sanitized TP rank-0 reproduction config derived from the live snapshot. Hostnames and
# operator-local paths were generalized. The breakable-graph setting marked below was
# added after its A/B test; do not read this file as raw proof of one historical run.
# This is not a rank-1/2 snapshot. Rank 0 binds the OpenAI API on :8100.
NODE_RANK=0
HEADLESS=
VLLM_HOST_IP=192.168.200.1
VLLM_HOST=0.0.0.0
VLLM_PORT=8100

NCCL_IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0

DSPARK_MODEL_HOST=/srv/models/DeepSeek-V4-Flash-0731
HF_CACHE=/var/cache/huggingface
DSPARK_TMP_HOST=/var/tmp/dspark

# ---- TP=3 with attention-group padding (o_groups 8 -> 9) ----
# Stock vLLM in the tested image rejects 64 heads / TP=3. If only that validation
# is bypassed, n_local_groups = 8 // 3 == 2 represents 6 global groups and loses 2.
# The patch mounted at
# /opt/dsv4-tp3 pads the GROUP count and holds heads_per_group at 8 so the
# o_proj BMM `r` dim stays 4096, matching wo_a=[8192,4096] in the checkpoint.
# Verified no-op at TP<=2: pad_groups_for_tp(8,2) == 8.
TP_SIZE=3
PP_SIZE=1
NNODES=3
MOE_BACKEND=flashinfer_b12x
TP3_PATCH_DIR=/opt/dsv4-tp3-src
VLLM_DSV4_TP_PAD=1

MASTER_ADDR=192.168.200.1
MASTER_PORT=25000

# Phase 1: Socket transport, to isolate patch correctness from the fabric.
# Phase 2 flips these to RoCE across the mesh.
NCCL_IB_DISABLE=0
NCCL_NET=IB
NCCL_DEBUG=WARN

DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1
SERVED_MODEL_NAME=deepseek-v4-flash-0731

# MTP stays ON -- tok/s is the goal, and TP=3 (unlike PP) supports it.
# Identical on all three ranks; a mismatch hangs startup forever with no log.
MAX_MODEL_LEN=460800
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85
MTP_NUM_TOKENS=4
JIT_MONITOR_MODE=warn

# Explicitly opt out of the auto-enabled breakable path. The clean A/B found no
# decode-throughput gain, but reduced graph capture from 9s/0.99GiB to 5s/0.44GiB.
# The container/Compose launch must forward this variable on all three ranks.
VLLM_USE_BREAKABLE_CUDAGRAPH=0

# NVIDIA switchless 3-Spark ring: pick the HCA whose subnet matches the peer
# instead of pairing by device index. Verified in the loaded runtime NCCL 2.30.7;
# other system/Python reports may identify a different installed NCCL version.
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_NET_PLUGIN=none
