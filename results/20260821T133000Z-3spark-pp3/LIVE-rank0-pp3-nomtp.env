# PP rank 0 -- sparkmain. binds the OpenAI API on :8100.
NODE_RANK=0
HEADLESS=
VLLM_HOST_IP=192.168.99.1
VLLM_HOST=0.0.0.0
VLLM_PORT=8100

NCCL_IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f0np0,enp1s0f1np1
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0,enp1s0f1np1

DSPARK_MODEL_HOST=/home/sparkmain/dsv4/hf-DeepSeek-V4-Flash-0731
HF_CACHE=/home/sparkmain/.cache/huggingface
DSPARK_TMP_HOST=/home/sparkmain/localai/dspark-tmp

# ---- PP=3 experiment: TP=1 / PP=3 / EP off, B12X expected to survive ----
# use_ep = (dp*pcp*tp > 1) and enable_expert_parallel  -> False here, so
# FusedMoEParallelConfig reports ep_size=1 and the B12X gate
# (_supports_parallel_config) passes. That is the whole point of this run.
TP_SIZE=1
PP_SIZE=3
NNODES=3
MOE_BACKEND=flashinfer_b12x
# 43 hidden layers. vLLM auto-splits 14,15,14; set explicitly so it cannot drift.
VLLM_PP_LAYER_PARTITION=14,15,14

MASTER_ADDR=192.168.99.100
MASTER_PORT=25000

# The RoCE triangle has no 3-node RDMA ring in this runtime; Socket is the only
# transport proven to work across all three. Revisit with --topology ring.
NCCL_IB_DISABLE=1
NCCL_NET=Socket
NCCL_IB_ADDR_RANGE=192.168.99.0/24
NCCL_DEBUG=WARN

DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1
SERVED_MODEL_NAME=deepseek-v4-flash-0731

# Identical on all three ranks -- a mismatch hangs startup forever with no log.
MAX_MODEL_LEN=460800
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85
MTP_NUM_TOKENS=5
JIT_MONITOR_MODE=warn

# ---- MTP OFF ----
# DeepSeekMTP (deepseek_mtp.py:223) does not implement SupportsPP, so vLLM
# raises NotImplementedError when PP>1 with a speculative draft attached.
# SPEC_ARGS= (empty) removes --speculative-config entirely.
SPEC_ARGS=
