# DP rank 1 -- spark1 (gx10-e146). Headless: never binds an API socket.
DP_START_RANK_ARG=--data-parallel-start-rank 1
DP_ADDRESS=192.168.99.100
DP_RPC_PORT=25100
HEADLESS=1
VLLM_HOST_IP=192.168.99.2

NCCL_IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f0np0,enp1s0f1np1
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0,enp1s0f1np1

DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1
DSPARK_MODEL_HOST=/home/spark1/dsv4/hf-DeepSeek-V4-Flash-0731
HF_CACHE=/home/spark1/.cache/huggingface
DSPARK_TMP_HOST=/home/spark1/localai/dspark-tmp
SERVED_MODEL_NAME=deepseek-v4-flash-0731

VLLM_HOST=127.0.0.1
VLLM_PORT=8100

MAX_MODEL_LEN=460800
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85
MTP_NUM_TOKENS=5
JIT_MONITOR_MODE=warn
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,ENV

NCCL_IB_ADDR_RANGE=192.168.99.0/24
NCCL_IB_DISABLE=1
NCCL_NET=Socket
VLLM_USE_B12X_MOE=0
MOE_BACKEND=auto
DP_SIZE=2
