# DP rank 2 -- spark-sep (node2, user `spark2`). Headless.
#
# This node has NO direct link to 192.168.100.0/24. It reaches DP_ADDRESS
# (192.168.100.1) through its 192.168.101.0/30 link to sparkmain, which forwards.
# scripts/ep3-routes.sh installs that route; without it NCCL bootstrap hangs.
#
# VLLM_HOST_IP is this node's own fabric address on the link toward the DP
# leader, so peers learn an address they can actually route back to.
DP_START_RANK_ARG=--data-parallel-start-rank 2
DP_ADDRESS=192.168.99.100
DP_RPC_PORT=25100
HEADLESS=1
VLLM_HOST_IP=192.168.99.6

# rocep1s0f0 backs enp1s0f0np0, which on THIS node is the 192.168.101.0/30 link
# to sparkmain (not the .100 fabric -- spark-sep is not on it).
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f0np0,enp1s0f1np1
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0,enp1s0f1np1

DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1
DSPARK_MODEL_HOST=/home/spark2/dsv4/hf-DeepSeek-V4-Flash-0731
HF_CACHE=/home/spark2/.cache/huggingface
DSPARK_TMP_HOST=/home/spark2/localai/dspark-tmp
SERVED_MODEL_NAME=deepseek-v4-flash-0731

VLLM_HOST=127.0.0.1
VLLM_PORT=8100

MAX_MODEL_LEN=460800
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85
MTP_NUM_TOKENS=5
JIT_MONITOR_MODE=warn
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,ENV

NCCL_IB_ADDR_RANGE=192.168.99.0/24
NCCL_IB_DISABLE=1
NCCL_NET=Socket
VLLM_USE_B12X_MOE=0
MOE_BACKEND=auto
