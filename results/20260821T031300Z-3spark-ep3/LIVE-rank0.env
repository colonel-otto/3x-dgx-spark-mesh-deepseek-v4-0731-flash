# DP rank 0 -- sparkmain (node0). This node binds the OpenAI API on :8100.
# DP_ADDRESS must be an address every rank can reach. 192.168.100.1 is
# sparkmain's fabric address; spark-sep reaches it via the routes in
# scripts/ep3-routes.sh (it has no direct link to 192.168.100.0/24).
# Head passes NO rank flag. Supplying --data-parallel-rank here would switch
# vLLM into external-LB mode, which forbids --headless on the workers.
DP_START_RANK_ARG=
DP_ADDRESS=192.168.99.100
DP_RPC_PORT=25100
HEADLESS=
VLLM_HOST_IP=192.168.99.1

NCCL_IB_HCA=rocep1s0f1,rocep1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0,enp1s0f1np1
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0,enp1s0f1np1

DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1
DSPARK_MODEL_HOST=/home/sparkmain/dsv4/hf-DeepSeek-V4-Flash-0731
HF_CACHE=/home/sparkmain/.cache/huggingface
DSPARK_TMP_HOST=/home/sparkmain/localai/dspark-tmp
SERVED_MODEL_NAME=deepseek-v4-flash-0731

# Bind all interfaces, same reasoning as the 2-Spark head.env.
# NOTE: still no auth -- LAN-trusted only, never port-forward this.
VLLM_HOST=0.0.0.0
VLLM_PORT=8100

# Identical on all three ranks. A mismatch hangs startup forever at ~96% GPU
# with no log output after weight load -- the same failure mode as the 2-node
# rank mismatch. Change all three files together or not at all.
MAX_MODEL_LEN=460800
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85
MTP_NUM_TOKENS=5
JIT_MONITOR_MODE=warn
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,ENV

NCCL_IB_ADDR_RANGE=192.168.99.0/24
NCCL_IB_DISABLE=1
NCCL_NET=Socket
VLLM_USE_B12X_MOE=0
MOE_BACKEND=auto
DP_SIZE=2
