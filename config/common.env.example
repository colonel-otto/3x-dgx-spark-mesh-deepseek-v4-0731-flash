# Copy into each rank file and replace site-specific placeholders.
#
# This is the SETTLED profile as of 2026-08-25. It is NOT the historical
# 460800 / seqs=8 / 0.85 / MTP=4 profile that earlier docs describe -- that
# profile is superseded. See config/tp3.env.example for the pitfalls behind
# every value here, and docs/DECISIONS.md for what was measured to settle them.
TP_SIZE=3
PP_SIZE=1
NNODES=3
MOE_BACKEND=flashinfer_b12x

# 1M context is free here: memory-bound, not communication-bound.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=32
GPU_MEMORY_UTILIZATION=0.80
# MTP=5 beats 4 (matched control 2026-08-24). MTP=0 is invalid; vLLM rejects it.
MTP_NUM_TOKENS=5
# Do NOT raise to 16384 despite vLLM's own log suggesting it: measured here at
# 43% of the KV pool for zero gain.
MAX_NUM_BATCHED_TOKENS=8192
VLLM_USE_BREAKABLE_CUDAGRAPH=0

NCCL_IB_DISABLE=0
NCCL_NET=IB
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_NET_PLUGIN=none
# SUPERSEDED 2026-08-26: the roceP2p pair IS now in production. The wedge it
# caused was the degraded fabric on spark1 (issue #14), not the HCAs. All four
# are addressed and gated clean; see docs/HANDOFF.md 4b and config/tp3.env.example.
# Throughput benefit measured: none (results/20260826-four-hca-throughput) --
# it is used because it is correct and redundant, not because it is faster.
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
NCCL_NVLS_ENABLE=0
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1

# INFO for validation/evidence capture; WARN for routine serving.
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,GRAPH

MASTER_ADDR=192.168.200.1
MASTER_PORT=29500
MODEL_PATH=/replace/with/local/checkpoint
