# Copy into each rank file and replace site-specific placeholders.
TP_SIZE=3
PP_SIZE=1
NNODES=3
MOE_BACKEND=flashinfer_b12x

MAX_MODEL_LEN=460800
MAX_NUM_SEQS=16
GPU_MEMORY_UTILIZATION=0.85
MTP_NUM_TOKENS=5

NCCL_IB_DISABLE=0
NCCL_NET=IB
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_NET_PLUGIN=none
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_NVLS_ENABLE=0
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1

# INFO for validation/evidence capture; WARN for routine serving.
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,GRAPH

MASTER_ADDR=192.168.200.1
MASTER_PORT=29500
MODEL_PATH=/replace/with/local/checkpoint
