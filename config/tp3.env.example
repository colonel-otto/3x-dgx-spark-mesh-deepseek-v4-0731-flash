# =============================================================================
# DeepSeek-V4-Flash on 3x DGX Spark (GB10), TP=3 across nodes.
#
# Copy to config/tp3.env on EACH of the three nodes and edit the rank header.
# Everything below the header MUST be byte-identical across ranks.
#
#   *** A MISMATCH IN ANY PARALLELISM FLAG HANGS STARTUP FOREVER WITH NO ERROR ***
#
# Verify before every start:
#   KEYS='MAX_MODEL_LEN|MAX_NUM_SEQS|MTP_NUM_TOKENS|GPU_MEMORY_UTILIZATION|TP_SIZE|NNODES'
#   for h in node0 node1 node2; do printf "%-10s " $h
#     ssh $h "grep -E '^($KEYS)=' ~/localai/dspark-vllm-gx10/config/tp3.env|sort|md5sum"; done
#
# Read docs/POSTMORTEM-2026-08-25.md before changing anything in here.
# =============================================================================

# ---- RANK HEADER: these MUST DIFFER per node --------------------------------
# rank 0 is the head and the ONLY node that serves; workers emit nothing.
NODE_RANK=0
HEADLESS=                       # empty on rank 0; "1" on workers
VLLM_HOST_IP=192.168.200.1      # this node's own fabric address
VLLM_HOST=0.0.0.0               # rank 0 binds all; workers use 127.0.0.1
VLLM_PORT=8100

# NOTE: on the head, VLLM_HOST_IP is a /32 on LOOPBACK, not on a NIC. It must be
# persisted (see PERSISTENCE below) or a reboot makes the cluster unstartable.

# ---- NCCL DEVICE SELECTION --------------------------------------------------
# A GB10 QSFP port enumerates as TWO controllers (~100G each): rocep1s0fN and
# roceP2p1s0fN. Using all four DOUBLES fabric bandwidth:
#     pairs      4.60-4.73 -> 9.15-9.70 GB/s
#     all three       2.85 -> 5.80 GB/s
#
# *** THIS IS SAFE ONLY BECAUSE THE UPPER PAIR IS FULLY ADDRESSED ***
# An earlier attempt at this WEDGED THE CLUSTER. The upper pair then had no
# IPv4 -- only link-local IPv6 -- so NCCL selected it, spammed "GID table
# changed", and failed live traffic with IBV_WC_RETRY_EXC_ERR (both GIDs
# fe80::). All three ranks still COMPLETED INIT and every container stayed
# "running"; the engine simply never finished loading. There is no container
# health check to catch this.
#
# Prerequisites, ALL of them, before listing four HCAs:
#   1. IPv4 on a unique /30 per controller (NVIDIA: one address/subnet each)
#   2. Routes to every peer fabric address
#   3. Persisted in /etc/netplan -- NOT just nmcli (see PERSISTENCE below)
#   4. `scripts/fabric_gate.sh <cfg>` clean, INCLUDING rdma:* with the engine UP
#
# Verified 2026-08-25: live gate 21/21, rdma:* 0 errors on all three ranks.
# Revert to `rocep1s0f0,rocep1s0f1` if any IBV_WC_*_ERR appears.
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1

# Per-node: the interface facing the OTHER ranks. Differs per node.
# *** NO SPARK-TO-SPARK DATA MAY CROSS WI-FI. *** Wi-Fi (wlP9s9) is for operator
# access and API responses only. These MUST name fabric interfaces. If a fabric
# route goes missing the kernel falls back to Wi-Fi silently -- every ping still
# succeeds while inter-node traffic crawls (0.47-0.93ms fabric vs 3-135ms Wi-Fi)
# and nothing reports an error. Gated by fabric_gate.sh as egress:*.
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0

# ---- PATHS (per node) -------------------------------------------------------
DSPARK_MODEL_HOST=/home/YOURUSER/dsv4/hf-DeepSeek-V4-Flash-0731
HF_CACHE=/home/YOURUSER/.cache/huggingface
DSPARK_TMP_HOST=/home/YOURUSER/localai/dspark-tmp

# ---- TP=3 ATTENTION-GROUP PADDING -- REQUIRED, NOT OPTIONAL -----------------
# *** PITFALL: stock vLLM at TP=3 SILENTLY SERVES NONSENSE ***
# It computes n_local_groups = 8 // 3 == 2, dropping 6 of 8 attention groups.
# Output stays fluent, so this does NOT look like a crash. The patch mounted at
# /opt/dsv4-tp3 pads the GROUP count 8->9 and holds heads_per_group at 8 so the
# o_proj BMM r-dim stays 4096, matching wo_a=[8192,4096] in the checkpoint.
# Verified no-op at TP<=2: pad_groups_for_tp(8,2) == 8.
# ALWAYS run a correctness check after any restart (17x23 -> 391).
TP_SIZE=3
PP_SIZE=1
NNODES=3
MOE_BACKEND=flashinfer_b12x
TP3_PATCH_DIR=/opt/dsv4-tp3-src
VLLM_DSV4_TP_PAD=1

MASTER_ADDR=192.168.200.1       # rank 0's fabric address, same on ALL ranks
MASTER_PORT=25000

# ---- TRANSPORT --------------------------------------------------------------
# NCCL_NET=IB is a REQUEST, not a guarantee. If IB init fails NCCL falls back to
# sockets and reports a plausible number -- we measured NET/Socket at 0.44 GB/s
# and it looked real. ALWAYS confirm "via NET/IB/x" in the logs.
NCCL_IB_DISABLE=0
NCCL_NET=IB
NCCL_DEBUG=INFO

# Switchless ring: select the HCA whose SUBNET reaches the peer rather than
# pairing by device index. NOTE: not documented in NVIDIA's public NCCL env
# reference, but present in the NCCL 2.30.7 binary.
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_NET_PLUGIN=none
NCCL_TIMEOUT=3600

DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1
SERVED_MODEL_NAME=deepseek-v4-flash-0731

# ---- ENGINE SHAPE -- identical on all ranks ---------------------------------
# 1M context is FREE here: memory-bound, not communication-bound. Settled.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=16
# *** PITFALL: do NOT raise to 16384. ***
# vLLM's own log suggests it for throughput; that guidance assumes intra-node
# NVLink. Here it cost 43% of the KV pool for ZERO gain, and it raises per-step
# allreduce bytes over a ~3 GB/s fabric. Measured and reverted.
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.80
# MTP=5 beats 4 (matched control 2026-08-24). MTP=0 is INVALID -- vLLM rejects
# num_speculative_tokens: 0 and the service fails to start. Floor is 1, and
# MTP=1 collapses decode to ~47 tok/s.
MTP_NUM_TOKENS=5
# Leave at "warn". This surfaces JIT compiles landing during inference, which
# cause multi-second latency spikes -- one measured at 5s inside a request.
JIT_MONITOR_MODE=warn

# ---- KV CACHE DTYPE -- settled 2026-08-26, either value is fine --------------
# A/B'd both ways on this cluster (#16). nvfp4_ds_mla and fp8_ds_mla are:
#   memory-identical -- vLLM uses the SAME 584-byte sparse-MLA envelope for both
#                       on DeepseekV4, confirmed in kv_cache_interface.py
#   speed-identical  -- all deltas <3% and the SIGN FLIPS across concurrency
#   quality-identical-- 35/36 each; 23 of 24 matched cells returned BYTE-IDENTICAL
#                       replies, including 12/12 at 246K tokens
#
# fp8_ds_mla is what both official recipes specify, so prefer it for a NEW
# deployment. We stay on nvfp4_ds_mla because it is measured-equal and switching
# a working cluster buys nothing.
#
# Select with KV_CACHE_DTYPE; docker-compose.yml reads ${KV_CACHE_DTYPE:-nvfp4_ds_mla}.
# It is an ENGINE-SHAPING key: it MUST match across all three ranks or startup
# hangs forever with no error. dsv4-service-start now checks it.
#
# Do NOT "optimize" this to fp8_e4m3 -- that is a different, generic dtype.

# =============================================================================
# PERSISTENCE -- READ THIS
#
# NetworkManager on these boxes is only a RENDERER; netplan OWNS the config.
# Every NM connection lives in /run/NetworkManager/system-connections/ (tmpfs,
# WIPED ON REBOOT) and /etc/NetworkManager/system-connections/ is EMPTY.
#
# An `nmcli con mod` that does not write through to /etc/netplan/ looks applied
# and silently reverts on next boot. This nearly cost us the cluster once:
# 192.168.200.1 existed only on the head's loopback at runtime.
#
# Verify:  scripts/fabric_gate.sh configs/<your>.env
# =============================================================================

# =============================================================================
# BEFORE ANY BENCHMARK
#   scripts/fabric_gate.sh configs/<your>.env --nccl=full   # engine STOPPED
# A healthy GB10 pair reports ~4.6 GB/s busbw @64MiB; ~0.7 means a degraded node
# -- reboot it. TCP throughput is NOT a valid check; it hid a 6.8x RDMA deficit
# behind a 1.19x TCP one.
# =============================================================================
